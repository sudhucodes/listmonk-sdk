{
    "name": "listmonk-sdk",
    "version": "0.0.2",
    "description": "A lightweight, type-safe TypeScript SDK for Listmonk with a clean Resend-like API",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "listmonk",
        "listmonk-sdk",
        "email",
        "newsletter",
        "subscribers",
        "campaigns",
        "transactional",
        "typescript"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^26.6.4",
        "dotenv": "^18.0.5",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^5.0.3"
    }
}